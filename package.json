{
  "private": true,
  "version": "1.0.0",
  "name": "evanlindsey.github.io",
  "author": "Evan Lindsey",
  "description": "evanlindsey.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evanlindsey/evanlindsey.github.io.git"
  },
  "scripts": {
    "setup": "bundle install",
    "serve": "bundle exec jekyll serve",
    "build": "bundle exec jekyll build",
