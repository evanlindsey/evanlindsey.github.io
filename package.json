    "lint": "eslint \"**/*.js\"",
    "fix": "npm run format && npm run lint --fix"
  },
  "devDependencies": {
    "coffeescript": "^2.7.0",
    "eslint": "^9.16.0",
    "prettier": "^3.5.2"
  }
